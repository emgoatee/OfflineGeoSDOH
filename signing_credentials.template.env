# macOS Signing and Notarization Credentials
# COPY THIS FILE TO .env AND FILL IN THE VALUES

# The name of your Developer ID Application certificate (for the .app)
# Example: "Developer ID Application: Your Name (TeamID)"
APPLE_SIGNING_IDENTITY="Developer ID Application: Bobbin LLC (8YY98N4P3K)"

# The name of your Developer ID Installer certificate (for the .pkg)
# Example: "Developer ID Installer: Your Name (TeamID)"
APPLE_INSTALLER_IDENTITY="Developer ID Installer: Bobbin LLC (8YY98N4P3K)"

# Your Apple ID (email address) used for the developer account
APPLE_ID="email@example.com"

# An App-Specific Password for notarization (Generate at appleid.apple.com)
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your Team ID (found in Apple Developer Portal)
APPLE_TEAM_ID="8YY98N4P3K"
